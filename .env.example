# CafeBot environment settings (EXAMPLE)
#
# How to use:
#   1. Copy this file and name the copy ".env" (in the same folder).
#   2. Replace each placeholder with your real value in .env only.
#   3. Never share or commit .env. This example file must contain placeholders only.

# --- AI API ---
# Your secret API key from your AI provider.
AI_API_KEY=your_key_here

# Which AI model to use (the model name from your provider's docs).
AI_MODEL=your_model_name_here

# Highest number of tokens (roughly, words) the bot may use in one reply.
AI_MAX_TOKENS=your_max_tokens_here

# --- Backend server ---
# Port number the backend runs on.
PORT=your_port_here

# --- Order and session storage (optional) ---
# Leave these out on your own computer: orders then go to data/orders.json and chat
# sessions stay in memory. On Vercel, connecting an Upstash Redis database to the project
# sets them for you, so orders and sessions are kept in Redis.
KV_REST_API_URL=your_upstash_redis_rest_url_here
KV_REST_API_TOKEN=your_upstash_redis_rest_token_here

# --- Staff dashboard ---
# Password for the staff dashboard at /staff (at least 16 characters, long and random).
# The dashboard stays switched off until this is set.
STAFF_TOKEN=your_staff_password_here
